@page "/cadastro-cliente"

@using Baltec.models
@using Baltec.DAO

<PageTitle>Cadastro de Cliente - Baltec</PageTitle>

<div class="form-container">

    <header class="page-header">
        <div>
            <h1>Cadastro de Cliente</h1>
            <p class="subtitle">
                Cadastre empresas, indústrias, comércios ou produtores.
            </p>
        </div>
    </header>

    <div class="card">

        <div class="form-grid">

            <div class="form-group">
                <label for="razaoSocial">Razão Social <span class="text-danger" aria-hidden="true">*</span></label>
                <input id="razaoSocial" type="text"
                       @bind="NovoCliente.RazaoSocial"
                       placeholder="Digite a razão social" required aria-required="true" />
            </div>

            <div class="form-group">
                <label for="nomeFantasia">Nome Fantasia</label>
                <input id="nomeFantasia" type="text"
                       @bind="NovoCliente.NomeFantasia"
                       placeholder="Digite o nome fantasia" />
            </div>

            <div class="form-group">
                <label for="cnpjCpf">CNPJ/CPF <span class="text-danger" aria-hidden="true">*</span></label>
                <input id="cnpjCpf" type="text"
                       @bind="NovoCliente.CnpjCpf"
                       placeholder="Digite o CNPJ ou CPF" required aria-required="true" />
            </div>

            <div class="form-group">
                <label for="telefone">Telefone</label>
                <input id="telefone" type="text"
                       @bind="NovoCliente.Telefone"
                       placeholder="Digite o telefone" />
            </div>

            <div class="form-group">
                <label for="email">E-mail</label>
                <input id="email" type="email"
                       @bind="NovoCliente.Email"
                       placeholder="Digite o e-mail" />
            </div>

            <div class="form-group">
                <label for="endereco">Endereço</label>
                <input id="endereco" type="text"
                       @bind="NovoCliente.Endereco"
                       placeholder="Digite o endereço" />
            </div>

            <div class="form-group">
                <label for="cidade">Cidade</label>
                <input id="cidade" type="text"
                       @bind="NovoCliente.Cidade"
                       placeholder="Digite a cidade" />
            </div>

            <div class="form-group">
                <label for="estado">Estado</label>
                <input id="estado" type="text"
                       maxlength="2"
                       @bind="NovoCliente.Estado"
                       placeholder="UF" />
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(MensagemErro))
        {
            <div class="alert alert-danger" role="alert" aria-live="assertive">
                @MensagemErro
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(MensagemSucesso))
        {
            <div class="alert alert-success" role="status" aria-live="polite">
                @MensagemSucesso
            </div>
        }

        <div class="form-actions">

            <button class="btn btn-primary"
                    @onclick="SalvarCliente">
                Salvar Cliente
            </button>

            <a href="/balanca"
                   class="btn btn-secondary">
                Cancelar
            </a>

        </div>

    </div>
</div>

@code {

    [Inject]
    private ClienteDAO ClienteDAO { get; set; } = default!;

    private Cliente NovoCliente = new()
    {
        Ativo = true,
        DataCadastro = DateTime.Now
    };

    private string MensagemErro = "";
    private string MensagemSucesso = "";

    private async Task SalvarCliente()
    {
        MensagemErro = "";
        MensagemSucesso = "";

        if (string.IsNullOrWhiteSpace(NovoCliente.RazaoSocial))
        {
            MensagemErro = "Informe a razão social.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NovoCliente.CnpjCpf))
        {
            MensagemErro = "Informe o CNPJ ou CPF.";
            return;
        }

        NovoCliente.CnpjCpf =
            NovoCliente.CnpjCpf.Trim();

        bool documentoExiste =
            await ClienteDAO.ExisteCnpjCpfAsync(
                NovoCliente.CnpjCpf
            );

        if (documentoExiste)
        {
            MensagemErro =
                "Este CNPJ/CPF já está cadastrado.";

            return;
        }

        NovoCliente.DataCadastro = DateTime.Now;
        NovoCliente.Ativo = true;

        bool sucesso =
            await ClienteDAO.InserirAsync(
                NovoCliente
            );

        if (sucesso)
        {
            MensagemSucesso =
                "Cliente cadastrado com sucesso!";

            NovoCliente = new Cliente
            {
                Ativo = true,
                DataCadastro = DateTime.Now
            };
        }
        else
        {
            MensagemErro =
                "Não foi possível cadastrar o cliente.";
        }
    }
}