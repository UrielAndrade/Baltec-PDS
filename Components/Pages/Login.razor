@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Login - Baltec</PageTitle>

<main class="page-background">
    <div class="container">
        <img class="baltec-logo" src="/imgs/logo.svg" alt="Logo da Baltec" />
        <form class="login-form" @onsubmit:preventDefault>
            <h1>Login</h1>
            <div class="input-group">
                <label for="email">Email</label>
                <input id="email" type="email" @bind="email" placeholder="Digite seu email" />
            </div>
            <div class="input-group">
                <label for="senha">Senha</label>
                <div class="password-wrapper">
                    <input id="senha" type="@(mostrarSenha ? "text" : "password")"
                           @bind="senha" placeholder="Digite sua senha" />
                    <button type="button" class="input-icon" @onclick="ToggleSenha" aria-label="@(mostrarSenha ? "Ocultar senha" : "Mostrar senha")" aria-pressed="@mostrarSenha">
                        <img src="/imgs/eye.svg" alt="" aria-hidden="true" />
                    </button>
                </div>
            </div>

            <button type="button" @onclick="Entrar">Entrar</button>
            <p class="register-link">Não tem uma conta? <a href="/cadastro">Cadastre-se</a></p>
        </form>
        <p class="version">Versão 1.0.0 - © 2026 Baltec</p>
    </div>
</main>

@code {
    private string email = "";
    private string senha = "";
    private bool mostrarSenha = false;

    private void ToggleSenha() => mostrarSenha = !mostrarSenha;

    private void Entrar()
    {
        Navigation.NavigateTo("/inicio");
    }
}