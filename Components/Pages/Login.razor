@page "/"

<PageTitle>Login baltec</PageTitle>


<header>
    <nav>
    <a href="/sobre-nos">Sobre-nos</a>
    <a href="/contato">Contato</a>
    </nav>
</header>

<div class="container">
    <img class="logo" src="/imgs/baltec.svg" alt="Logo da Baltec" class="logo"/>
    <form class="login-form">
        <h1>Login</h1>
        <p>Email</p>
        <input type="text" placeholder="Digite seu email" />
        <p>Senha</p>
        <input type="password" placeholder="Digite sua senha "alt="reveal password"/>
        <span class="input-icon">
            <img src="/imgs/eye.svg" alt="reveal password" />
        </span>
        <button>Entrar</button>
        <p>Não tem uma conta? <a href="/cadastro">Cadastre-se</a></p>
    </form>
</div>
<p>Versão 1.0.0 - © 2026 Baltec</p>
