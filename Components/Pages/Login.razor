@page "/"

<PageTitle>Login baltec</PageTitle>


<header>
    <nav>
    <a href="/sobre-nos">Sobre-nos</a>
    <a href="/contato">Contato</a>
    </nav>
</header>
<main class="page-background">
<div class="container">
    <img class="baltec" src="/imgs/baltec.svg" alt="Logo da Baltec"/>
    <form class="login-form">
        <h1>Login</h1>
        <div class="input-group">
            <label>Email</label>
            <input type="text" placeholder="Digite seu email" />
        </div>
        <div class="input-group">
            <label>Senha</label>
            <div class="password-wrapper">
                <input type="password" placeholder="Digite sua senha" />
                <span class="input-icon">
                    <img src="/imgs/eye.svg" alt="reveal password" />
                </span>
            </div>
        </div>
        <button type="button">Entrar</button>
        <p class="register-link">Não tem uma conta? <a href="/cadastro">Cadastre-se</a></p>
    </form>
    <p class="version">Versão 1.0.0 - © 2026 Baltec</p>
</div>
</main>