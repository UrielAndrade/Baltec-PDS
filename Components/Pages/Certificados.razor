    private IEnumerable<CertificadoCalibracao> CertificadosFiltrados
    {
        get
        {
            var resultado = listaCertificados.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(termoBusca))
            {
                var termo = termoBusca.Trim().ToLower();
                resultado = resultado.Where(c =>
                    c.NumeroCertificado.ToLower().Contains(termo) ||
                    (c.EquipamentoModelo != null && c.EquipamentoModelo.ToLower().Contains(termo)) ||
                    (c.ClienteNome != null && c.ClienteNome.ToLower().Contains(termo)));
            }

            if (filtroStatus == "valido")
            {
                resultado = resultado.Where(c => GetStatusValidade(c.DataProximaCalibracao) == StatusCertificado.Valido);
            }
            else if (filtroStatus == "prestes")
            {
                resultado = resultado.Where(c => GetStatusValidade(c.DataProximaCalibracao) == StatusCertificado.PrestesAVencer);
            }
            else if (filtroStatus == "vencido")
            {
                resultado = resultado.Where(c => GetStatusValidade(c.DataProximaCalibracao) == StatusCertificado.Vencido);
            }

            return resultado;
        }
    }

    private StatusCertificado GetStatusValidade(DateTime dataProximaCalibracao)
    {
        var diasRestantes = (dataProximaCalibracao.Date - DateTime.Today).TotalDays;
        if (diasRestantes < 0) return StatusCertificado.Vencido;
        if (diasRestantes <= 30) return StatusCertificado.PrestesAVencer;
        return StatusCertificado.Valido;
    }

    private async Task AbrirModalNovo()
    {
        var proximoNumero = await CertificadoDAO.GerarProximoNumeroCertificadoAsync();
        var dataHoje = DateTime.Today;

        novoCertificado = new CertificadoCalibracao
        {
            NumeroCertificado = proximoNumero,
            DataCalibracao = dataHoje,
            DataProximaCalibracao = dataHoje.AddYears(1),
            TemperaturaAmbiente = 22.0m,
            UmidadeRelativa = 55.0m,
            FkEquipamento = listaEquipamentos.FirstOrDefault()?.Id ?? 0,
            FkTecnicoResponsavel = listaTecnicos.FirstOrDefault()?.Id ?? 0
        };

        dataCalibracaoInput = dataHoje.ToString("yyyy-MM-dd");
        dataProximaCalibracaoInput = dataHoje.AddYears(1).ToString("yyyy-MM-dd");

        exibirModalNovo = true;
    }

    private void FecharModalNovo()
    {
        exibirModalNovo = false;
    }

    private void OnDataCalibracaoChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out DateTime dataCalib))
        {
            novoCertificado.DataCalibracao = dataCalib;
            novoCertificado.DataProximaCalibracao = dataCalib.AddYears(1);
            dataCalibracaoInput = dataCalib.ToString("yyyy-MM-dd");
            dataProximaCalibracaoInput = novoCertificado.DataProximaCalibracao.ToString("yyyy-MM-dd");
        }
    }

    private async Task SalvarCertificado()
    {
        if (novoCertificado.FkEquipamento <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Selecione um equipamento válido.");
            return;
        }

        if (novoCertificado.FkTecnicoResponsavel <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Selecione um técnico responsável.");
            return;
        }

        var equip = listaEquipamentos.FirstOrDefault(e => e.Id == novoCertificado.FkEquipamento);
        if (equip != null)
        {
            novoCertificado.EquipamentoModelo = equip.Modelo;
            novoCertificado.EquipamentoSerie = equip.NumeroSerie;
            novoCertificado.ClienteNome = equip.ClienteNome;
        }

        var tec = listaTecnicos.FirstOrDefault(t => t.Id == novoCertificado.FkTecnicoResponsavel);
        if (tec != null)
        {
            novoCertificado.TecnicoNome = tec.Nome;
        }

        novoCertificado.DataEmissao = DateTime.Now;

        await CertificadoDAO.InserirAsync(novoCertificado);

        // Atualizar lista local
        listaCertificados.Insert(0, novoCertificado);

        exibirModalNovo = false;
        await JS.InvokeVoidAsync("alert", $"Certificado {novoCertificado.NumeroCertificado} emitido com sucesso!");
    }

