@page "/balanca"
@rendermode InteractiveServer

@using Baltec.models
@using Baltec.DAO

@inject EquipamentoDAO EquipamentoDAO
@inject ClienteDAO ClienteDAO
@inject NavigationManager NavigationManager

<PageTitle>Cadastro de Balanças - Baltec</PageTitle>

<div class="balanca-container">

    <header class="page-header">
        <div class="header-titles">
            <div class="title-row">
                <h1>Balanças</h1>
                <span class="badge-total">@EquipamentosFiltrados.Count() Cadastradas</span>
            </div>
            <p class="subtitle">
                Gerencie os equipamentos e balanças cadastrados no sistema.
            </p>
        </div>

        <div class="header-actions">
            <button class="btn btn-outline" @onclick='() => NavigationManager.NavigateTo("/inicio")'>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
                Painel
            </button>
            <button class="btn btn-primary" @onclick="AbrirModal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Nova Balança
            </button>
        </div>
    </header>

    <!-- CARDS DE RESUMO (KPIS) -->
    <div class="kpi-grid">
        <div class="kpi-card total" @onclick="() => SelecionarFiltroStatus(null)">
            <div class="kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
            </div>
            <div class="kpi-info">
                <span class="kpi-title">Total de Balanças</span>
                <span class="kpi-number">@Equipamentos.Count</span>
            </div>
        </div>

        <div class="kpi-card ativas @(FiltroStatusAtivo == true ? "kpi-active" : "")" @onclick="() => SelecionarFiltroStatus(true)">
            <div class="kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <div class="kpi-info">
                <span class="kpi-title">Balanças Ativas</span>
                <span class="kpi-number">@Equipamentos.Count(e => e.Ativo)</span>
            </div>
        </div>

        <div class="kpi-card inativas @(FiltroStatusAtivo == false ? "kpi-active" : "")" @onclick="() => SelecionarFiltroStatus(false)">
            <div class="kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
            </div>
            <div class="kpi-info">
                <span class="kpi-title">Inativas</span>
                <span class="kpi-number">@Equipamentos.Count(e => !e.Ativo)</span>
            </div>
        </div>

        <div class="kpi-card clientes">
            <div class="kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                </svg>
            </div>
            <div class="kpi-info">
                <span class="kpi-title">Clientes Vinculados</span>
                <span class="kpi-number">@Equipamentos.Select(e => e.FkCliente).Distinct().Count()</span>
            </div>
        </div>
    </div>

    <!-- FILTROS E PESQUISA -->
    <div class="filters-card">
        <div class="status-tabs">
            <button type="button" class="tab-btn @(FiltroStatusAtivo == null ? "active" : "")" @onclick="() => SelecionarFiltroStatus(null)">
                Todas <span class="tab-count">@Equipamentos.Count</span>
            </button>
            <button type="button" class="tab-btn tab-ativa @(FiltroStatusAtivo == true ? "active" : "")" @onclick="() => SelecionarFiltroStatus(true)">
                Ativas <span class="tab-count">@Equipamentos.Count(e => e.Ativo)</span>
            </button>
            <button type="button" class="tab-btn tab-inativa @(FiltroStatusAtivo == false ? "active" : "")" @onclick="() => SelecionarFiltroStatus(false)">
                Inativas <span class="tab-count">@Equipamentos.Count(e => !e.Ativo)</span>
            </button>
        </div>

        <div class="filter-controls">
            <div class="client-filter-box">
                <select class="form-control select-cliente-filtro" value="@FiltroClienteId" @onchange="OnClienteFiltroChanged">
                    <option value="0">Todos os Clientes</option>
                    @foreach (var cli in Clientes)
                    {
                        <option value="@cli.Id">@cli.RazaoSocial</option>
                    }
                </select>
            </div>

            <div class="search-wrapper">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text"
                       class="search-input"
                       placeholder="Pesquisar por modelo, fabricante, série ou cliente..."
                       @bind="Pesquisa"
                       @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(Pesquisa))
                {
                    <button class="clear-search" aria-label="Limpar pesquisa" @onclick='() => Pesquisa = ""'>&times;</button>
                }
            </div>
        </div>
    </div>

    <!-- TABELA ESTILIZADA DE BALANÇAS -->
    <div class="table-card">
        @if (Carregando)
        {
            <div class="state-container">
                <div class="spinner"></div>
                <p>Carregando balanças...</p>
            </div>
        }
        else if (!EquipamentosFiltrados.Any())
        {
            <div class="state-container empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <h3>Nenhuma balança encontrada</h3>
                <p>Nenhum equipamento corresponde aos filtros aplicados.</p>
                <button class="btn btn-primary" @onclick="AbrirModal">
                    Cadastrar Balança
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="balanca-table">
                    <thead>
                        <tr>
                            <th>Balança / Modelo</th>
                            <th>Fabricante</th>
                            <th>Capacidade / Divisão</th>
                            <th>Nº de Série</th>
                            <th>Cliente Proprietário</th>
                            <th>Setor / Local</th>
                            <th>Status</th>
                            <th class="text-right">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var equipamento in EquipamentosFiltrados)
                        {
                            <tr class="@(!equipamento.Ativo ? "row-inactive" : "")">
                                <td class="col-modelo">
                                    <strong>@equipamento.Modelo</strong>
                                </td>

                                <td class="col-fabricante">
                                    @equipamento.MarcaFabricante
                                </td>

                                <td class="col-capacidade">
                                    <div class="cap-weight">@equipamento.CapacidadeMaximaKg.ToString("0.###") kg</div>
                                    <span class="sub-text">e = @equipamento.DivisaoEscalaG.ToString("0.###") g</span>
                                </td>

                                <td class="col-serie">
                                    <span class="badge-serie">@equipamento.NumeroSerie</span>
                                </td>

                                <td class="col-cliente">
                                    <strong>@(string.IsNullOrEmpty(equipamento.ClienteNome) ? $"Cliente #{equipamento.FkCliente}" : equipamento.ClienteNome)</strong>
                                </td>

                                <td class="col-setor">
                                    <span class="tag-setor">@equipamento.SetorLocalizacao</span>
                                </td>

                                <td class="col-status">
                                    @if (equipamento.Ativo)
                                    {
                                        <span class="status-badge status-ativo">Ativa</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inativo">Inativa</span>
                                    }
                                </td>

                                <td class="col-acoes text-right">
                                    <div class="action-buttons">
                                        <button class="btn-action btn-detalhes" title="Ver detalhes completos" @onclick="() => AbrirModalDetalhes(equipamento)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                            Ver
                                        </button>

                                        <button class="btn-action btn-editar" title="Editar dados da balança" @onclick="() => AbrirModalEditar(equipamento)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                            Editar
                                        </button>

                                        <button class="btn-action @(equipamento.Ativo ? "btn-toggle-off" : "btn-toggle-on")"
                                                title="@(equipamento.Ativo ? "Desativar balança" : "Ativar balança")"
                                                @onclick="() => AlternarStatus(equipamento)">
                                            @(equipamento.Ativo ? "Desativar" : "Ativar")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- MODAL CADASTRAR / EDITAR -->
@if (MostrarModal)
{
    <div class="modal-backdrop" @onclick="FecharModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title-box">
                    <span class="modal-badge">@(EhEdicao ? "Editar Balança" : "Nova Balança")</span>
                    <h2>@(EhEdicao ? $"Editar #{NovaBalanca.Id} - {NovaBalanca.Modelo}" : "Nova Balança")</h2>
                </div>
                <button type="button" class="btn-close" aria-label="Fechar modal" @onclick="FecharModal">&times;</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(MensagemErro))
                {
                    <div class="form-alert error">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>@MensagemErro</span>
                    </div>
                }

                <div class="form-grid">
                    <div class="form-group full-width">
                        <div class="label-with-action">
                            <label for="cliente">Cliente Proprietário *</label>
                            <button type="button" class="btn-client" @onclick="CadastrarClienteRapido">
                                Cadastrar cliente
                            </button>
                        </div>
                        <select id="cliente" class="form-control" @bind="NovaBalanca.FkCliente">
                            <option value="0">Selecione um cliente...</option>
                            @foreach (var cliente in Clientes)
                            {
                                <option value="@cliente.Id">@cliente.RazaoSocial</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="modelo">Modelo *</label>
                        <input type="text"
                               id="modelo"
                               class="form-control"
                               placeholder="Ex: Filizola Platinum, Toledo 2090"
                               @bind="NovaBalanca.Modelo" />
                    </div>

                    <div class="form-group">
                        <label for="marca">Marca / Fabricante *</label>
                        <input type="text"
                               id="marca"
                               class="form-control"
                               placeholder="Ex: Toledo, Filizola, Radwag"
                               @bind="NovaBalanca.MarcaFabricante" />
                    </div>

                    <div class="form-group">
                        <label for="capacidade">Capacidade Máxima (kg) *</label>
                        <input type="number"
                               id="capacidade"
                               step="0.001"
                               min="0.001"
                               class="form-control"
                               placeholder="Ex: 30"
                               @bind="NovaBalanca.CapacidadeMaximaKg" />
                    </div>

                    <div class="form-group">
                        <label for="divisao">Divisão / Escala (g) *</label>
                        <input type="number"
                               id="divisao"
                               step="0.001"
                               min="0.001"
                               class="form-control"
                               placeholder="Ex: 5"
                               @bind="NovaBalanca.DivisaoEscalaG" />
                    </div>

                    <div class="form-group">
                        <label for="numSerie">Número de Série *</label>
                        <input type="text"
                               id="numSerie"
                               class="form-control mono-input"
                               placeholder="Ex: SN-2026-987"
                               @bind="NovaBalanca.NumeroSerie" />
                    </div>

                    <div class="form-group">
                        <label for="setor">Setor / Localização *</label>
                        <input type="text"
                               id="setor"
                               class="form-control"
                               placeholder="Ex: Expedição, Linha de Produção"
                               @bind="NovaBalanca.SetorLocalizacao" />
                    </div>

                    @if (EhEdicao)
                    {
                        <div class="form-group full-width">
                            <label class="checkbox-container">
                                <input type="checkbox" @bind="NovaBalanca.Ativo" />
                                <span class="checkbox-label">Balança Ativa no Sistema</span>
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="FecharModal" disabled="@Salvando">
                    Cancelar
                </button>
                <button type="button" class="btn btn-primary" @onclick="SalvarBalanca" disabled="@Salvando">
                    @(Salvando ? "Salvando..." : (EhEdicao ? "Salvar Alterações" : "Salvar Balança"))
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL DETALHES -->
@if (MostrarModalDetalhes && BalancaDetalhes != null)
{
    <div class="modal-backdrop" @onclick="FecharModalDetalhes">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title-box">
                    <span class="modal-badge">Ficha Técnica</span>
                    <h2>@BalancaDetalhes.Modelo</h2>
                </div>
                <button type="button" class="btn-close" aria-label="Fechar modal" @onclick="FecharModalDetalhes">&times;</button>
            </div>

            <div class="modal-body">
                <div class="details-status-strip">
                    <div class="strip-label">Status Operacional:</div>
                    <span class="status-badge @(BalancaDetalhes.Ativo ? "status-ativo" : "status-inativo") large">
                        @(BalancaDetalhes.Ativo ? "Ativa" : "Inativa")
                    </span>

                    <div class="strip-actions">
                        <button class="btn btn-sm btn-outline" @onclick="() => AbrirModalEditar(BalancaDetalhes)">
                            Editar Cadastro
                        </button>
                        <button class="btn btn-sm btn-primary" @onclick='() => NavigationManager.NavigateTo("/os")'>
                            Abrir Ordem de Serviço
                        </button>
                    </div>
                </div>

                <div class="details-grid">
                    <div class="detail-box">
                        <span class="box-title">Cliente Proprietário</span>
                        <p class="box-val highlight">@(BalancaDetalhes.ClienteNome ?? $"Cliente #{BalancaDetalhes.FkCliente}")</p>
                    </div>

                    <div class="detail-box">
                        <span class="box-title">Fabricante / Marca</span>
                        <p class="box-val">@BalancaDetalhes.MarcaFabricante</p>
                    </div>

                    <div class="detail-box">
                        <span class="box-title">Número de Série</span>
                        <p class="box-val"><span class="badge-serie">@BalancaDetalhes.NumeroSerie</span></p>
                    </div>

                    <div class="detail-box">
                        <span class="box-title">Setor / Localização</span>
                        <p class="box-val">@BalancaDetalhes.SetorLocalizacao</p>
                    </div>

                    <div class="detail-box">
                        <span class="box-title">Capacidade Máxima</span>
                        <p class="box-val text-bold">@BalancaDetalhes.CapacidadeMaximaKg.ToString("0.###") kg</p>
                    </div>

                    <div class="detail-box">
                        <span class="box-title">Divisão Metrológica</span>
                        <p class="box-val text-bold">@BalancaDetalhes.DivisaoEscalaG.ToString("0.###") g</p>
                    </div>

                    <div class="detail-box full-width">
                        <span class="box-title">Data de Cadastro</span>
                        <p class="box-desc">@BalancaDetalhes.DataCadastro.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="FecharModalDetalhes">
                    Fechar
                </button>
                <button type="button" class="btn btn-primary" @onclick="() => AbrirModalEditar(BalancaDetalhes)">
                    Editar Balança
                </button>
            </div>
        </div>
    </div>
}

<!-- TOAST -->
@if (MostrarToast)
{
    <div class="toast-notification @(ToastTipo == "success" ? "toast-success" : "toast-info")">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            @if (ToastTipo == "success")
            {
                <polyline points="20 6 9 17 4 12"></polyline>
            }
            else
            {
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            }
        </svg>
        <span>@MensagemToast</span>
    </div>
}

@code {
    private string MensagemErro = "";
    private string MensagemToast = "";
    private string ToastTipo = "success";
    private bool MostrarToast = false;
    private bool Carregando = true;
    private bool Salvando = false;

    private List<Equipamento> Equipamentos = new();
    private List<Cliente> Clientes = new();

    private Equipamento NovaBalanca = new()
    {
        Ativo = true,
        DataCadastro = DateTime.Now
    };

    private Equipamento? BalancaDetalhes = null;
    private bool EhEdicao = false;
    private string Pesquisa = "";
    private bool? FiltroStatusAtivo = null;
    private int FiltroClienteId = 0;
    private bool MostrarModal = false;
    private bool MostrarModalDetalhes = false;

    private IEnumerable<Equipamento> EquipamentosFiltrados =>
        Equipamentos.Where(e =>
            (FiltroStatusAtivo == null || e.Ativo == FiltroStatusAtivo.Value) &&
            (FiltroClienteId <= 0 || e.FkCliente == FiltroClienteId) &&
            (string.IsNullOrWhiteSpace(Pesquisa) ||
             e.Modelo.Contains(Pesquisa, StringComparison.OrdinalIgnoreCase) ||
             e.NumeroSerie.Contains(Pesquisa, StringComparison.OrdinalIgnoreCase) ||
             e.MarcaFabricante.Contains(Pesquisa, StringComparison.OrdinalIgnoreCase) ||
             (e.ClienteNome != null && e.ClienteNome.Contains(Pesquisa, StringComparison.OrdinalIgnoreCase)) ||
             e.SetorLocalizacao.Contains(Pesquisa, StringComparison.OrdinalIgnoreCase))
        ).OrderByDescending(e => e.Id);

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        Carregando = true;
        try
        {
            Equipamentos = await EquipamentoDAO.ListarTodosComClienteAsync();
            Clientes = await ClienteDAO.ListarTodosAsync();
        }
        catch (Exception ex)
        {
            await ExibirToast($"Erro ao carregar dados: {ex.Message}", "error");
        }
        finally
        {
            Carregando = false;
        }
    }

    private void SelecionarFiltroStatus(bool? status)
    {
        FiltroStatusAtivo = status;
    }

    private void OnClienteFiltroChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            FiltroClienteId = id;
        }
        else
        {
            FiltroClienteId = 0;
        }
    }

    private void AbrirModal()
    {
        EhEdicao = false;
        MensagemErro = "";
        NovaBalanca = new Equipamento
        {
            Ativo = true,
            DataCadastro = DateTime.Now,
            FkCliente = FiltroClienteId > 0 ? FiltroClienteId : 0
        };
        MostrarModal = true;
    }

    private void AbrirModalEditar(Equipamento item)
    {
        EhEdicao = true;
        MensagemErro = "";
        NovaBalanca = new Equipamento
        {
            Id = item.Id,
            FkCliente = item.FkCliente,
            ClienteNome = item.ClienteNome,
            Modelo = item.Modelo,
            MarcaFabricante = item.MarcaFabricante,
            CapacidadeMaximaKg = item.CapacidadeMaximaKg,
            DivisaoEscalaG = item.DivisaoEscalaG,
            NumeroSerie = item.NumeroSerie,
            SetorLocalizacao = item.SetorLocalizacao,
            DataCadastro = item.DataCadastro,
            Ativo = item.Ativo
        };

        if (MostrarModalDetalhes)
        {
            MostrarModalDetalhes = false;
        }

        MostrarModal = true;
    }

    private void FecharModal()
    {
        MostrarModal = false;
    }

    private void AbrirModalDetalhes(Equipamento item)
    {
        BalancaDetalhes = item;
        MostrarModalDetalhes = true;
    }

    private void FecharModalDetalhes()
    {
        MostrarModalDetalhes = false;
        BalancaDetalhes = null;
    }

    private async Task AlternarStatus(Equipamento item)
    {
        try
        {
            item.Ativo = !item.Ativo;
            bool ok = await EquipamentoDAO.AtualizarAsync(item);
            if (ok)
            {
                await CarregarDados();
                await ExibirToast($"Balança {item.NumeroSerie} {(item.Ativo ? "ativada" : "desativada")} com sucesso!");
            }
        }
        catch (Exception ex)
        {
            await ExibirToast($"Erro ao alternar status: {ex.Message}", "error");
        }
    }

    private async Task SalvarBalanca()
    {
        MensagemErro = "";

        if (NovaBalanca.FkCliente <= 0)
        {
            MensagemErro = "Selecione um cliente para a balança.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NovaBalanca.Modelo))
        {
            MensagemErro = "Informe o modelo da balança.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NovaBalanca.MarcaFabricante))
        {
            MensagemErro = "Informe a marca/fabricante.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NovaBalanca.NumeroSerie))
        {
            MensagemErro = "Informe o número de série.";
            return;
        }

        if (NovaBalanca.CapacidadeMaximaKg <= 0)
        {
            MensagemErro = "A capacidade máxima deve ser maior que zero.";
            return;
        }

        if (NovaBalanca.DivisaoEscalaG <= 0)
        {
            MensagemErro = "A divisão/escala deve ser maior que zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NovaBalanca.SetorLocalizacao))
        {
            MensagemErro = "Informe o setor/localização.";
            return;
        }

        var serieTrim = NovaBalanca.NumeroSerie.Trim();

        // Validação de número de série duplicado
        var equipamentoExistente = await EquipamentoDAO.BuscarPorNumeroSerieAsync(serieTrim);
        if (equipamentoExistente != null && (!EhEdicao || equipamentoExistente.Id != NovaBalanca.Id))
        {
            MensagemErro = "Já existe uma balança cadastrada com este número de série.";
            return;
        }

        Salvando = true;

        try
        {
            NovaBalanca.NumeroSerie = serieTrim;
            NovaBalanca.Modelo = NovaBalanca.Modelo.Trim();
            NovaBalanca.MarcaFabricante = NovaBalanca.MarcaFabricante.Trim();
            NovaBalanca.SetorLocalizacao = NovaBalanca.SetorLocalizacao.Trim();

            bool sucesso;

            if (EhEdicao)
            {
                sucesso = await EquipamentoDAO.AtualizarAsync(NovaBalanca);
            }
            else
            {
                NovaBalanca.DataCadastro = DateTime.Now;
                NovaBalanca.Ativo = true;
                sucesso = await EquipamentoDAO.InserirAsync(NovaBalanca);
            }

            if (sucesso)
            {
                MostrarModal = false;
                await CarregarDados();
                await ExibirToast(EhEdicao ? "Balança atualizada com sucesso!" : "Balança cadastrada com sucesso!");
            }
            else
            {
                MensagemErro = "Não foi possível salvar a balança.";
            }
        }
        catch (Exception ex)
        {
            MensagemErro = $"Erro ao salvar: {ex.Message}";
        }
        finally
        {
            Salvando = false;
        }
    }

    private void CadastrarClienteRapido()
    {
        NavigationManager.NavigateTo("/cadastro-cliente");
    }

    private async Task ExibirToast(string mensagem, string tipo = "success")
    {
        MensagemToast = mensagem;
        ToastTipo = tipo;
        MostrarToast = true;
        StateHasChanged();

        await Task.Delay(3500);
        MostrarToast = false;
        StateHasChanged();
    }
}