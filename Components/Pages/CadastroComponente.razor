@page "/componentes/cadastro"
@rendermode InteractiveServer

@using Baltec.models
@using Baltec.DAO

@inject ComponenteDAO ComponenteDAO
@inject NavigationManager NavigationManager

<PageTitle>Novo Componente - Baltec</PageTitle>

<div class="cadastro-componente">
    <div class="cabecalho-cadastro">
        <div>
            <h1>Novo componente</h1>
            <p>Cadastre uma nova peça no estoque.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensagemErro))
    {
        <div class="mensagem erro">@mensagemErro</div>
    }

    <div class="card cadastro-card">
        <EditForm Model="componente" OnValidSubmit="Salvar">
            <DataAnnotationsValidator />
            <ValidationSummary class="mensagem erro" />

            <div class="form-grid">
                <div class="campo">
                    <label for="nome">Nome do componente</label>
                    <InputText id="nome" class="form-control" @bind-Value="componente.Nome" placeholder="Ex: Célula de carga 50kg" />
                    <ValidationMessage For="() => componente.Nome" />
                </div>

                <div class="campo">
                    <label for="codigo">Código do item</label>
                    <InputText id="codigo" class="form-control" @bind-Value="componente.CodigoItem" placeholder="Ex: COMP-987-AB" />
                    <ValidationMessage For="() => componente.CodigoItem" />
                </div>

                <div class="campo">
                    <label for="categoria">Categoria</label>
                    <InputSelect id="categoria" class="form-select" @bind-Value="componente.FkCategoria">
                        <option value="0">Selecione uma categoria</option>
                        @foreach (var categoria in categorias)
                        {
                            <option value="@categoria.Id">@categoria.Nome</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => componente.FkCategoria" />
                </div>

                <div class="campo">
                    <label for="quantidade">Quantidade inicial</label>
                    <InputNumber id="quantidade" class="form-control" @bind-Value="componente.QuantidadeEstoque" />
                    <ValidationMessage For="() => componente.QuantidadeEstoque" />
                </div>

                <div class="campo">
                    <label for="preco">Preço unitário</label>
                    <InputNumber id="preco" class="form-control" @bind-Value="componente.PrecoUnitario" />
                    <ValidationMessage For="() => componente.PrecoUnitario" />
                </div>
            </div>

            <div class="acoes-cadastro">
                <button type="submit" class="btn-salvar" disabled="@salvando">
                    @(salvando ? "Salvando..." : "Salvar componente")
                </button>
                <button type="button" class="btn-cancelar" @onclick="Cancelar">Cancelar</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Componente componente = new();
    private List<CategoriaComponente> categorias = new();
    private string mensagemErro = string.Empty;
    private bool salvando;

    protected override async Task OnInitializedAsync()
    {
        categorias = await ComponenteDAO.ListarCategoriasAsync();
    }

    private async Task Salvar()
    {
        mensagemErro = string.Empty;
        salvando = true;

        try
        {
            var existente = await ComponenteDAO.BuscarPorCodigoAsync(componente.CodigoItem.Trim());

            if (existente != null)
            {
                mensagemErro = "Já existe um componente com esse código.";
                return;
            }

            componente.Nome = componente.Nome.Trim();
            componente.CodigoItem = componente.CodigoItem.Trim();
            componente.Ativo = true;

            var sucesso = await ComponenteDAO.InserirAsync(componente);

            if (sucesso)
            {
                NavigationManager.NavigateTo("/componentes");
                return;
            }

            mensagemErro = "Não foi possível cadastrar o componente.";
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao cadastrar o componente: {ex.Message}";
        }
        finally
        {
            salvando = false;
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/componentes");
    }
}
