@page "/componentes"
@rendermode InteractiveServer

@using Baltec.models
@using Baltec.DAO

@inject ComponenteDAO ComponenteDAO
@inject MovimentacaoEstoqueDAO MovimentacaoDAO
@inject NavigationManager NavigationManager

<PageTitle>Componentes</PageTitle>

<div class="pagina-componentes">
    <div class="cabecalho">
        <div>
            <h1>Componentes</h1>
            <p>Cadastro e controle de estoque de peças.</p>
        </div>

        <a class="btn-principal" href="/componentes/cadastro">
            + Novo componente
        </a>
    </div>

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <div class="mensagem">@mensagem</div>
    }

    <div class="card">
        <div class="card-topo">
            <h2>Estoque de componentes</h2>
            <button type="button" class="btn-atualizar" @onclick="CarregarDados">
                Atualizar
            </button>
        </div>

        @if (carregando)
        {
            <p>Carregando...</p>
        }
        else if (componentes.Count == 0)
        {
            <div class="vazio">
                Nenhum componente cadastrado.
            </div>
        }
        else
        {
            <div class="tabela-container">
                <table>
                    <thead>
                        <tr>
                            <th>Peça</th>
                            <th>Código</th>
                            <th>Categoria</th>
                            <th>Estoque</th>
                            <th>Preço</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var componente in componentes)
                        {
                            <tr>
                                <td><strong>@componente.Nome</strong></td>
                                <td>@componente.CodigoItem</td>
                                <td>@componente.CategoriaNome</td>
                                <td>
                                    <span class="estoque @(componente.QuantidadeEstoque < 5 ? "baixo" : "normal")">
                                        @componente.QuantidadeEstoque
                                    </span>
                                </td>
                                <td>@componente.PrecoUnitario.ToString("C2")</td>
                                <td>
                                    <button type="button" class="btn-estoque"
                                            @onclick="() => AbrirMovimentacao(componente)">
                                        Ajustar estoque
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (mostrarModalEstoque && componenteSelecionado != null)
{
    <div class="modal-fundo">
        <div class="modal">
            <div class="modal-cabecalho">
                <h2>Ajustar estoque</h2>
                <button type="button" aria-label="Fechar" @onclick="FecharModal">×</button>
            </div>

            <p class="componente-selecionado">
                <strong>@componenteSelecionado.Nome</strong><br />
                Estoque atual: @componenteSelecionado.QuantidadeEstoque
            </p>

            <div class="campo">
                <label for="tipo-movimentacao">Tipo de movimentação</label>
                <select id="tipo-movimentacao" @bind="tipoMovimentacao">
                    <option value="1">Entrada</option>
                    <option value="2">Saída</option>
                    <option value="3">Ajuste</option>
                </select>
            </div>

            <div class="campo">
                <label for="quantidade-movimentacao">Quantidade</label>
                <input id="quantidade-movimentacao" type="number" min="1" @bind="quantidadeMovimentacao" />
            </div>

            <div class="campo">
                <label for="motivo-movimentacao">Motivo</label>
                <input id="motivo-movimentacao" @bind="motivoMovimentacao" placeholder="Informe o motivo" />
            </div>

            <div class="campo">
                <label for="custo-movimentacao">Custo unitário</label>
                <input id="custo-movimentacao" type="number" min="0" step="0.01" @bind="custoMovimentacao" />
            </div>

            <div class="modal-botoes">
                <button type="button" class="btn-cancelar" @onclick="FecharModal">Cancelar</button>
                <button type="button" class="btn-salvar" @onclick="SalvarMovimentacao" disabled="@salvandoMovimentacao">
                    @(salvandoMovimentacao ? "Salvando..." : "Salvar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Componente> componentes = new();
    private Componente? componenteSelecionado;
    private bool carregando = true;
    private bool mostrarModalEstoque;
    private bool salvandoMovimentacao;
    private string mensagem = string.Empty;

    private int tipoMovimentacao = 1;
    private int quantidadeMovimentacao = 1;
    private string motivoMovimentacao = string.Empty;
    private decimal custoMovimentacao;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        carregando = true;

        try
        {
            componentes = await ComponenteDAO.ListarTodosAsync();
            mensagem = string.Empty;
        }
        catch (Exception ex)
        {
            mensagem = $"Não foi possível carregar os componentes: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }

    private void AbrirMovimentacao(Componente componente)
    {
        componenteSelecionado = componente;
        tipoMovimentacao = 1;
        quantidadeMovimentacao = 1;
        motivoMovimentacao = string.Empty;
        custoMovimentacao = componente.PrecoUnitario;
        mostrarModalEstoque = true;
        mensagem = string.Empty;
    }

    private void FecharModal()
    {
        mostrarModalEstoque = false;
        componenteSelecionado = null;
    }

    private async Task SalvarMovimentacao()
    {
        if (componenteSelecionado == null)
            return;

        mensagem = string.Empty;

        if (quantidadeMovimentacao <= 0)
        {
            mensagem = "Informe uma quantidade válida.";
            return;
        }

        if (string.IsNullOrWhiteSpace(motivoMovimentacao))
        {
            mensagem = "Informe o motivo da movimentação.";
            return;
        }

        if (custoMovimentacao < 0)
        {
            mensagem = "O custo unitário não pode ser negativo.";
            return;
        }

        salvandoMovimentacao = true;

        try
        {
            var movimentacao = new MovimentacaoEstoque
            {
                FkComponente = componenteSelecionado.Id,
                FkTipoMovimentacao = tipoMovimentacao,
                MotivoMovimentacao = motivoMovimentacao.Trim(),
                Quantidade = quantidadeMovimentacao,
                CustoUnitario = custoMovimentacao,
                // Substituir pelo usuário autenticado quando a integração de login estiver disponível.
                FkUsuarioResponsavel = 1
            };

            var sucesso = await MovimentacaoDAO.RegistrarMovimentacaoAsync(movimentacao);

            if (!sucesso)
            {
                mensagem = "Não foi possível atualizar o estoque. Verifique se há quantidade suficiente para uma saída.";
                return;
            }

            FecharModal();
            await CarregarDados();
            mensagem = "Estoque atualizado com sucesso.";
        }
        catch (Exception ex)
        {
            mensagem = $"Erro ao atualizar o estoque: {ex.Message}";
        }
        finally
        {
            salvandoMovimentacao = false;
        }
    }
}
