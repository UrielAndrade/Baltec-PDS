@inject NavigationManager NavigationManager

<div class="sidebar">
    <!-- Brand Logo Section -->
    <div class="sidebar-brand">
        <img class="logo" src="/imgs/baltec.svg" alt="Baltec Logo" />
    </div>
    
    <!-- Navigation Links -->
    <nav class="sidebar-nav">
        <!-- GENERAL SECTION -->
        <div class="nav-section-header">Geral</div>
        
        <div class="nav-item">
            <a class="nav-link @(IsActive("/inicio") ? "active" : "")" href="/inicio">
                <span class="nav-link-left">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Início</span>
                </span>
            </a>
        </div>

        <!-- OPERATIONAL SECTION -->
        <div class="nav-section-header">Cadastros</div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/cadastro-balanca") ? "active" : "")" href="/cadastro-balanca">
                <span class="nav-link-left">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="2" x2="12" y2="22"></line>
                        <line x1="5" y1="22" x2="19" y2="22"></line>
                        <line x1="5" y1="7" x2="19" y2="7"></line>
                        <path d="M2 17h6l-3-6z"></path>
                        <line x1="5" y1="7" x2="5" y2="11"></line>
                        <path d="M16 17h6l-3-6z"></path>
                        <line x1="19" y1="7" x2="19" y2="11"></line>
                    </svg>
                    <span>Cadastro de balança</span>
                </span>
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/cadastro-componente") ? "active" : "")" href="/cadastro-componente">
                <span class="nav-link-left">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="5" r="3"></circle>
                        <circle cx="5" cy="19" r="3"></circle>
                        <circle cx="19" cy="19" r="3"></circle>
                        <line x1="12" y1="8" x2="6.5" y2="16.5"></line>
                        <line x1="12" y1="8" x2="17.5" y2="16.5"></line>
                        <line x1="8" y1="19" x2="16" y2="19"></line>
                    </svg>
                    <span>Cadastro de componente</span>
                </span>
            </a>
        </div>

        <div class="nav-section-header">Serviços</div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/ordem-servico") ? "active" : "")" href="/ordem-servico">
                <span class="nav-link-left">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="6" x2="4" y2="18"></line>
                        <line x1="9" y1="6" x2="20" y2="6"></line>
                        <line x1="9" y1="12" x2="20" y2="12"></line>
                        <line x1="9" y1="18" x2="20" y2="18"></line>
                    </svg>
                    <span>Gerar ordem de serviço</span>
                </span>
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/cert-calibracao") ? "active" : "")" href="/cert-calibracao">
                <span class="nav-link-left">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span>Gerar cert. de calibração</span>
                </span>
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/ordem-servico-peca") ? "active" : "")" href="/ordem-servico-peca">
                <span class="nav-link-left">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19.5 10a2.5 2.5 0 0 1 0 5H18v1.5a2.5 2.5 0 0 1-2.5 2.5H14v1.5a2.5 2.5 0 0 1-5 0V19H7.5A2.5 2.5 0 0 1 5 16.5V15H3.5a2.5 2.5 0 0 1 0-5H5V8.5A2.5 2.5 0 0 1 7.5 6H9V4.5a2.5 2.5 0 0 1 5 0V6h1.5A2.5 2.5 0 0 1 18 8.5V10h1.5z"></path>
                    </svg>
                    <span>Gerar ordem de serviço de peça</span>
                </span>
            </a>
        </div>

        <div class="nav-section-header">Administrativo</div>

        <div class="nav-item">
            <button class="nav-link btn-expand @(IsActive("/financeiro") ? "active" : "")" @onclick="ToggleFinanceiro">
                <span class="nav-link-left">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                    <span>Financeiro</span>
                </span>
                <svg class="caret-icon @(isFinanceiroExpanded ? "expanded" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>
            
            <div class="submenu @(isFinanceiroExpanded ? "show" : "")">
                <a class="submenu-link @(IsActive("/financeiro/contas-pagar") ? "active" : "")" href="/financeiro/contas-pagar">
                    <span class="submenu-dot"></span>Contas a Pagar
                </a>
                <a class="submenu-link @(IsActive("/financeiro/contas-receber") ? "active" : "")" href="/financeiro/contas-receber">
                    <span class="submenu-dot"></span>Contas a Receber
                </a>
                <a class="submenu-link @(IsActive("/financeiro/fluxo-caixa") ? "active" : "")" href="/financeiro/fluxo-caixa">
                    <span class="submenu-dot"></span>Fluxo de Caixa
                </a>
            </div>
        </div>
    </nav>

    <!-- User Profile & Logout Section at the Bottom -->
    <div class="sidebar-footer">
        <div class="user-profile">
            <div class="user-avatar">U</div>
            <div class="user-details">
                <div class="user-name">Usuário Baltec</div>
                <div class="user-role">Administrador</div>
            </div>
        </div>
        <button class="logout-button" @onclick="HandleLogout">
            <svg class="logout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Sair</span>
        </button>
    </div>
</div>

@code {
    private bool isFinanceiroExpanded = false;

    private void ToggleFinanceiro()
    {
        isFinanceiroExpanded = !isFinanceiroExpanded;
    }

    private void HandleLogout()
    {
        NavigationManager.NavigateTo("/");
    }

    private bool IsActive(string relativePath)
    {
        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        
        if (relativePath == "/inicio")
        {
            return relativeUri == "inicio" || string.IsNullOrEmpty(relativeUri);
        }

        return relativeUri.StartsWith(relativePath.TrimStart('/'));
    }
}
