@inject NavigationManager NavigationManager

<div class="sidebar">
    <div class="sidebar-brand">
        <img class="logo" src="/imgs/baltec.svg" alt="Baltec Logo" />
    </div>
    
    <nav class="sidebar-nav">
        <div class="nav-item">
            <a class="nav-link @(IsActive("/inicio") ? "active" : "")" href="/inicio">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>Início</span>
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/cadastro-balanca") ? "active" : "")" href="/cadastro-balanca">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="2" x2="12" y2="22"></line>
                    <line x1="5" y1="22" x2="19" y2="22"></line>
                    <line x1="5" y1="7" x2="19" y2="7"></line>
                    <path d="M2 17h6l-3-6z"></path>
                    <line x1="5" y1="7" x2="5" y2="11"></line>
                    <path d="M16 17h6l-3-6z"></path>
                    <line x1="19" y1="7" x2="19" y2="11"></line>
                </svg>
                <span>Cadastro de balança</span>
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/cadastro-componente") ? "active" : "")" href="/cadastro-componente">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="5" r="3"></circle>
                    <circle cx="5" cy="19" r="3"></circle>
                    <circle cx="19" cy="19" r="3"></circle>
                    <line x1="12" y1="8" x2="6.5" y2="16.5"></line>
                    <line x1="12" y1="8" x2="17.5" y2="16.5"></line>
                    <line x1="8" y1="19" x2="16" y2="19"></line>
                </svg>
                <span>Cadastro de componente</span>
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/ordem-servico") ? "active" : "")" href="/ordem-servico">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="6" x2="4" y2="18"></line>
                    <line x1="9" y1="6" x2="20" y2="6"></line>
                    <line x1="9" y1="12" x2="20" y2="12"></line>
                    <line x1="9" y1="18" x2="20" y2="18"></line>
                </svg>
                <span>Gerar ordem de serviço</span>
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/cert-calibracao") ? "active" : "")" href="/cert-calibracao">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                </svg>
                <span>Gerar cert. de calibração</span>
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/ordem-servico-peca") ? "active" : "")" href="/ordem-servico-peca">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19.5 10a2.5 2.5 0 0 1 0 5H18v1.5a2.5 2.5 0 0 1-2.5 2.5H14v1.5a2.5 2.5 0 0 1-5 0V19H7.5A2.5 2.5 0 0 1 5 16.5V15H3.5a2.5 2.5 0 0 1 0-5H5V8.5A2.5 2.5 0 0 1 7.5 6H9V4.5a2.5 2.5 0 0 1 5 0V6h1.5A2.5 2.5 0 0 1 18 8.5V10h1.5z"></path>
                </svg>
                <span>Gerar ordem de serviço de peça</span>
            </a>
        </div>

        <div class="nav-separator"></div>
        <div class="nav-section-title">Financeiro</div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/financeiro/contas-pagar") ? "active" : "")" href="/financeiro/contas-pagar">
                <div class="nav-link-left">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="2" y1="10" x2="22" y2="10"></line>
                    </svg>
                    <span>Contas a Pagar</span>
                </div>
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/financeiro/contas-receber") ? "active" : "")" href="/financeiro/contas-receber">
                <div class="nav-link-left">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                    <span>Contas a Receber</span>
                </div>
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link @(IsActive("/financeiro/fluxo-caixa") ? "active" : "")" href="/financeiro/fluxo-caixa">
                <div class="nav-link-left">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                        <polyline points="17 6 23 6 23 12"></polyline>
                    </svg>
                    <span>Fluxo de Caixa</span>
                </div>
            </a>
        </div>
    </nav>
</div>

@code {
    private bool IsActive(string relativePath)
    {
        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        
        if (relativePath == "/inicio")
        {
            return relativeUri == "inicio" || string.IsNullOrEmpty(relativeUri);
        }

        return relativeUri.StartsWith(relativePath.TrimStart('/'));
    }
}
